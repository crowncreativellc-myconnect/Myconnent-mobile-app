# ─── Supabase ────────────────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ─── AI / Smart Parsing ───────────────────────────────────────────────────────
# Used server-side only (Supabase Edge Functions) — never expose in client
OPENAI_API_KEY=sk-your-openai-api-key
# Alternative: Anthropic Claude for smart parsing
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# ─── Vector DB (Pinecone) ─────────────────────────────────────────────────────
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=your-pinecone-environment
PINECONE_INDEX_NAME=myconnect-skills

# ─── Push Notifications ───────────────────────────────────────────────────────
EXPO_PUBLIC_FCM_SENDER_ID=your-firebase-sender-id

# ─── App Config ───────────────────────────────────────────────────────────────
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_VERSION=1.0.0

# ─── Contact hashing (silent 2nd-degree bridging) ─────────────────────────────
# App-wide pepper used when hashing phone/email on device. Must be the same
# across every install so two users hashing the same contact match. NOT a
# security boundary — phone numbers are enumerable regardless. Change only
# to intentionally invalidate all existing hashes (fine in beta).
EXPO_PUBLIC_CONTACT_HASH_PEPPER=mykonnect-beta-v1

# ─── EAS ─────────────────────────────────────────────────────────────────────
EAS_PROJECT_ID=your-eas-project-id

# ─── Stripe ──────────────────────────────────────────────────────────────────
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
# Secret key — server-side only in Edge Functions, NEVER in client
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# MyKonnect platform Stripe account ID
STRIPE_PLATFORM_ACCOUNT_ID=acct_your_platform_account_id
# Service fee percentage as a decimal
STRIPE_SERVICE_FEE_PERCENT=0.08
